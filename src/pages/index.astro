---
import '../styles/global.css';

const title = 'SpecScore Studio — Specs your AI agent can actually follow';
const description = 'SpecScore Studio connects the open SpecScore format, agent skills for writing specifications, and a browser workspace for browsing specs in GitHub repositories.';
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-0GL9H4EQ40" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-0GL9H4EQ40');
    </script>
  </head>
  <body>
    <main>
      <section class="hero">
        <div class="container">
          <div class="brand">SpecScore Studio</div>
          <h1>Specs your AI agent can actually follow.</h1>
          <p class="lede">
            SpecScore Studio is the first-party workspace for the open <a href="https://specscore.md">SpecScore</a> spec format. The agent plugin helps turn ideas into structured specifications, while the <a href="/app/">browser workspace</a> lets you browse specs in GitHub repositories. Browser editing is planned.
          </p>
          <div class="install">
            <p class="install-label">Install the Claude Code plugin</p>
            <pre class="snippet"><code>/plugin marketplace add specscore/ai-marketplace
/plugin install specstudio@specscore</code></pre>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <h2>What it is</h2>
          <p>
            <strong>SpecScore</strong> is an open standard for AI-readable software specifications — a directory of Markdown files describing features, requirements, and acceptance criteria, scored for completeness before any code is written.
          </p>
          <p>
            <strong>SpecScore Studio</strong> is its first-party authoring tool. The agent skills bring the spec-driven development workflow to Claude Code and other supported assistants: <em>ideate · specify · plan · build · verify · recap · review · ship.</em> Each gate produces a lint-clean SpecScore artifact your agent can read, parse, and follow — instead of guessing from a vibe.
          </p>
          <p>
            The <a href="/app/">browser workspace</a> is available for exploring repository specs. Editing, graph views, and AI-assisted authoring remain planned work.
          </p>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <h2>Built on an open standard</h2>
          <p>
            The format is the format. There is no proprietary extension, no required runtime, no vendor lock-in. A SpecScore spec is a folder of Markdown that any tool, any agent, or any human can read — see <a href="https://specscore.md">specscore.md</a> for the specification.
          </p>
          <p>
            Studio's agent skills work across supported coding assistants. Specs authored with the skills can be read by any tool that understands the SpecScore format. Your specs travel with you.
          </p>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <h2>Understand unfamiliar data with DataTug</h2>
          <p><a href="https://datatug.app">DataTug</a> helps developers explore database schemas, build and run queries, and understand results. SpecScore guides its requirements and acceptance criteria; this example describes the methodology, not adoption of the Studio editor.</p>
          <p><a href="https://datatug.app/en/under-the-hood/tools-we-built/#specify">Explore the tools behind DataTug</a>.</p>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <h4>SpecScore Studio</h4>
            <ul>
              <li><a href="https://github.com/specscore/specstudio-skills">Plugin source (GitHub)</a></li>
              <li><a href="https://github.com/specscore/specscore-studio">This site (GitHub)</a></li>
              <li><a href="/about/tech-stack/">Tech stack</a></li>
            </ul>
          </div>
          <div>
            <h4>Ecosystem</h4>
            <ul>
              <li><a href="https://specscore.md">SpecScore (the standard)</a></li>
              <li><a href="https://github.com/specscore/ai-marketplace">SpecScore AI Marketplace</a></li>
              <li><a href="https://github.com/specscore/specscore-cli">specscore CLI</a></li>
            </ul>
          </div>
          <div>
            <h4>Org</h4>
            <ul>
              <li><a href="https://github.com/specscore">SpecScore on GitHub</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-meta">
          MIT-licensed open source · built with <a href="https://astro.build">Astro</a> · deployed on <a href="https://developers.cloudflare.com/workers/">Cloudflare Workers</a>
        </div>
      </div>
    </footer>
  </body>
</html>
